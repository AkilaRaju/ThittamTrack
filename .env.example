APP_NAME=ThittamTrack
ENVIRONMENT=local

# OpenAI-compatible Chat Completions API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=35
LLM_MAX_RETRIES=2

# USD per 1M tokens; update these rates for your provider/account.
PRIMARY_INPUT_USD_PER_MILLION=0.15
PRIMARY_OUTPUT_USD_PER_MILLION=0.60
FALLBACK_INPUT_USD_PER_MILLION=0.40
FALLBACK_OUTPUT_USD_PER_MILLION=1.60

# Docker Compose overrides this with the internal Postgres service URL.
DATABASE_URL=
